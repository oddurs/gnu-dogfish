{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oddurs/gnu-dogfish/blob/main/doc/schema/b2sum.v1.json",
  "title": "b2sum -J record",
  "description": "One file hashed by `b2sum -J`, or with --check one checked line. One record per line (NDJSON); version 1 of the Dogfish record format (doc/ndjson.md). Fields may be added in later releases.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The input, `-` for standard input."
        },
        "path_bytes": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "The bytes of `path`, base64, present only when they are not UTF-8 (`path` then holds the lossy form)."
        },
        "algorithm": {
          "type": "string",
          "const": "BLAKE2b",
          "description": "The algorithm, as GNU's --tag names it."
        },
        "digest": {
          "type": "string",
          "description": "The checksum, lower-case hexadecimal."
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Bytes read."
        }
      },
      "required": [
        "path",
        "algorithm",
        "digest",
        "bytes"
      ],
      "dependentRequired": {
        "path_bytes": [
          "path"
        ]
      }
    },
    {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The file named by the checksum line."
        },
        "path_bytes": {
          "type": "string",
          "contentEncoding": "base64",
          "description": "The bytes of `path`, base64, present only when they are not UTF-8 (`path` then holds the lossy form)."
        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "failed",
            "unreadable"
          ],
          "description": "The verdict: the checksum matched, did not, or the file could not be read."
        },
        "expected": {
          "type": "string",
          "description": "The checksum from the list."
        },
        "actual": {
          "type": "string",
          "description": "The checksum computed (absent when unreadable)."
        }
      },
      "required": [
        "path",
        "status",
        "expected"
      ],
      "dependentRequired": {
        "path_bytes": [
          "path"
        ]
      }
    }
  ]
}
