{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oddurs/gnu-dogfish/blob/main/doc/schema/wc.v1.json",
  "title": "wc -J record",
  "description": "The counts of one input of `wc -J`; every count is given, whatever options select. One record per line (NDJSON); version 1 of the Dogfish record format (doc/ndjson.md). Fields may be added in later releases.",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "description": "The input, `-` for standard input."
    },
    "lines": {
      "type": "integer",
      "minimum": 0,
      "description": "Newlines."
    },
    "words": {
      "type": "integer",
      "minimum": 0,
      "description": "Words."
    },
    "chars": {
      "type": "integer",
      "minimum": 0,
      "description": "Characters (bytes in a non-UTF-8 locale)."
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Bytes."
    },
    "max_line_length": {
      "type": "integer",
      "minimum": 0,
      "description": "The widest line's display width."
    }
  },
  "required": [
    "path",
    "lines",
    "words",
    "chars",
    "bytes",
    "max_line_length"
  ]
}
