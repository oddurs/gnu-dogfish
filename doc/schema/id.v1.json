{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oddurs/gnu-dogfish/blob/main/doc/schema/id.v1.json",
  "title": "id -J record",
  "description": "One user described by `id -J` (the current process, or each USER). One record per line (NDJSON); version 1 of the Dogfish record format (doc/ndjson.md). Fields may be added in later releases.",
  "type": "object",
  "properties": {
    "uid": {
      "type": "integer",
      "minimum": 0,
      "description": "The real user ID."
    },
    "user": {
      "type": "string",
      "description": "Its name; absent when it has none."
    },
    "gid": {
      "type": "integer",
      "minimum": 0,
      "description": "The real group ID."
    },
    "group": {
      "type": "string",
      "description": "Its name; absent when it has none."
    },
    "euid": {
      "type": "integer",
      "minimum": 0,
      "description": "The effective user ID."
    },
    "egid": {
      "type": "integer",
      "minimum": 0,
      "description": "The effective group ID."
    },
    "groups": {
      "type": "array",
      "description": "Every group, as `id -G` lists them.",
      "items": {
        "type": "object",
        "properties": {
          "gid": {
            "type": "integer",
            "minimum": 0,
            "description": "The group ID."
          },
          "name": {
            "type": "string",
            "description": "Its name; absent when it has none."
          }
        },
        "required": [
          "gid"
        ]
      }
    }
  },
  "required": [
    "uid",
    "gid",
    "euid",
    "egid",
    "groups"
  ]
}
