{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oddurs/gnu-dogfish/blob/main/doc/schema/uname.v1.json",
  "title": "uname -J record",
  "description": "The single record of `uname -J`: every field, whatever options select. One record per line (NDJSON); version 1 of the Dogfish record format (doc/ndjson.md). Fields may be added in later releases.",
  "type": "object",
  "properties": {
    "sysname": {
      "type": "string",
      "description": "Kernel name (-s)."
    },
    "nodename": {
      "type": "string",
      "description": "Network node host name (-n)."
    },
    "release": {
      "type": "string",
      "description": "Kernel release (-r)."
    },
    "version": {
      "type": "string",
      "description": "Kernel version (-v)."
    },
    "machine": {
      "type": "string",
      "description": "Machine hardware name (-m)."
    },
    "processor": {
      "type": "string",
      "description": "Processor type (-p)."
    },
    "hardware_platform": {
      "type": "string",
      "description": "Hardware platform (-i)."
    },
    "operating_system": {
      "type": "string",
      "description": "Operating system (-o)."
    }
  },
  "required": [
    "sysname",
    "nodename",
    "release",
    "version",
    "machine",
    "processor",
    "hardware_platform",
    "operating_system"
  ]
}
